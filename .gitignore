# Dependencies (the two node_modules folders account for 5,000+ generated files)
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/

# TypeScript and tool caches
*.tsbuildinfo
.vite/
**/.vite/
.vitest/
**/.vitest/
.cache/
**/.cache/

# Runtime logs and process files
*.log
logs/
**/logs/
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment and secrets (keep documented examples)
!.env.example
!**/.env.example

# Local browser/test artifacts
playwright-report/
test-results/
blob-report/
screenshots/
downloads/
*.webm

