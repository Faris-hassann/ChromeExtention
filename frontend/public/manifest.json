{
  "manifest_version": 3,
  "name": "Local Browser Agent",
  "description": "A browser agent with OpenRouter and local Ollama fallback, with access to all HTTP(S) sites.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "tabs", "scripting", "storage", "activeTab", "debugger", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Local Browser Agent" }
}
