{
  "manifest_version": 3,
  "name": "Local Browser Agent",
  "description": "A private, local-first browser agent powered by Ollama and Qwen.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "tabs", "scripting", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:3333/*", "http://localhost:3333/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Local Browser Agent" }
}
